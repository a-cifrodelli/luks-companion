# ===================================================================
# LUKS COMPANION CONFIGURATION (.env)
# ===================================================================

# -------------------------------------------------------------------
# 1. HOME ASSISTANT INTEGRATION (SMART PLUG 220V)
# -------------------------------------------------------------------
# Set to false for always-powered drives, USB pendrives, or internal disks
ENABLE_HOME_ASSISTANT=true
HA_URL="https://homeassistant.local:8123"
HA_TOKEN="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YourLongLivedAccessTokenHere..."
HA_ENTITY_ID="switch.presa_storage_nas"
HA_INSECURE_TLS=true
HA_WAIT_TIMEOUT=15

# -------------------------------------------------------------------
# 2. LVM & LUKS STORAGE LAYOUT & UNIFIED MOUNT STRUCTURE
# -------------------------------------------------------------------
VG_NAME="vg_nas"
LV_CRYPTO="lv_crypto"
MAPPER_NAME="crypto_data"

# Unified storage root directory (Punti di mount calcolati dinamicamente:
# - Dati Cifrati: ${STORAGE_BASE}/${MAPPER_NAME}
# - Secondo Volume (opzionale): ${STORAGE_BASE}/${LV_BACKUP}
# WebDAV espone direttamente tutti i volumi sotto questa cartella radice)
STORAGE_BASE="/srv/storage"

# Secondo volume LVM opzionale (es. volume backup non cifrato)
LV_BACKUP=""
# Esempio:
# LV_BACKUP="backup_data"

# Shared storage group for file access permissions (SGID 2775)
STORAGE_GROUP="storage"
STORAGE_PERMS="2775"

# Optional explicit block device (leave empty for automatic LVM detection)
TARGET_DEV=""

# -------------------------------------------------------------------
# 3. TIMEOUTS & SAFETY BEHAVIOR
# -------------------------------------------------------------------
USB_DETECT_TIMEOUT=40
MAX_PASSPHRASE_TRIES=3
SPINDOWN_WAIT_SEC=3
CUTOFF_GRACE_SEC=5
IDLE_TIMEOUT_MIN=30

# -------------------------------------------------------------------
# 4. WEBDAV FILE SHARING
# -------------------------------------------------------------------
ENABLE_WEBDAV=true
WEBDAV_PORT=9088
RELOAD_SAMBA=false

# -------------------------------------------------------------------
# 5. WEB DASHBOARD ENDPOINT (web/server.py)
# -------------------------------------------------------------------
WEB_HOST="0.0.0.0"
WEB_PORT=9099

# -------------------------------------------------------------------
# 6. DISCORD NOTIFICATIONS (OPTIONAL WEBHOOK)
# -------------------------------------------------------------------
# Lasciare vuoto per disabilitare completamente le notifiche (zero overhead)
DISCORD_WEBHOOK_URL=""
# Esempio:
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/1234567890/abcdefghijklmnopqrstuvwxyz"
