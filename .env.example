# ===================================================================
# LUKS-MANAGER CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your details:
#   cp .env.example .env
# ===================================================================

# Home Assistant REST API Settings
HA_URL="https://homeassistant.local:8123"
HA_TOKEN="YOUR_LONG_LIVED_ACCESS_TOKEN_HERE"
HA_ENTITY_ID="switch.your_smart_plug_entity"
HA_INSECURE_TLS=true

# Primary LVM & LUKS Storage Settings
VG_NAME="your_volume_group"
LV_CRYPTO="your_encrypted_lv"
MAPPER_NAME="your_luks_mapper_name"
MOUNT_CRYPTO="/mnt/encrypted_vault"

# Optional Second Volume/Partition Settings (Leave empty if using only 1 volume)
LV_BACKUP=""
MOUNT_BACKUP=""

# Target Block Device (Optional)
# Leave empty for dynamic auto-detection via LVM physical volume lookup.
TARGET_DEV=""

# Network Sharing Services Integration
ENABLE_WEBDAV=true
RELOAD_SAMBA=false

# Operational Options & Timeouts (in seconds)
HA_WAIT_TIMEOUT=15
USB_DETECT_TIMEOUT=40
MAX_PASSPHRASE_TRIES=3
SPINDOWN_WAIT_SEC=3
CUTOFF_GRACE_SEC=5
