# ===================================================================
# WEBDAV SERVER CONFIGURATION TEMPLATE FOR LUKS MANAGER
# Placeholders (${WEBDAV_USER}, ${WEBDAV_PASSWORD_HASH}, ${STORAGE_BASE}, ${WEBDAV_PORT})
# are dynamically populated by scripts/install-webdav.sh from .env
# ===================================================================
address: 0.0.0.0
port: ${WEBDAV_PORT}
directory: "${STORAGE_BASE}"
prefix: /
permissions: CRUD

users:
  - username: "${WEBDAV_USER}"
    password: "${WEBDAV_PASSWORD_HASH}"
    permissions: CRUD
