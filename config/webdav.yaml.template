# ===================================================================
# WEBDAV SERVER CONFIGURATION TEMPLATE FOR LUKS MANAGER
# Placeholders (${WEBDAV_USER}, ${WEBDAV_PASSWORD_HASH}, ${WEBDAV_SCOPE}, ${WEBDAV_PORT})
# are dynamically populated by scripts/install-webdav.sh from .env
# ===================================================================
address: 0.0.0.0
port: ${WEBDAV_PORT}
cert: ""
key: ""
auth: true
scope: "${WEBDAV_SCOPE}"

users:
  - username: "${WEBDAV_USER}"
    password: "${WEBDAV_PASSWORD_HASH}"
    scope: "${WEBDAV_SCOPE}"
    modify: true
