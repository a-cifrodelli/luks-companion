# ===================================================================
# LUKS-MANAGER SYSTEMD SERVICE TEMPLATE
# Placeholders (${SCRIPT_DIR}) are dynamically populated by scripts/install-service.sh
# ===================================================================
[Unit]
Description=LUKS2 / LVM Storage Subsystem Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${SCRIPT_DIR}
ExecStart=${SCRIPT_DIR}/luks-manager.sh
Restart=no
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
