# ===================================================================
# LUKS-MANAGER SOCKET DAEMON SYSTEMD SERVICE TEMPLATE
# Placeholders (${SCRIPT_DIR}) are dynamically populated by scripts/install-daemon.sh
# ===================================================================
[Unit]
Description=LUKS Manager UNIX Domain Socket Daemon for WebApp Integration
After=network.target

[Service]
Type=simple
WorkingDirectory=${SCRIPT_DIR}
ExecStart=/usr/bin/python3 ${SCRIPT_DIR}/scripts/luks-managerd.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
