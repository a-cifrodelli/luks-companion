# ===================================================================
# LUKS-MANAGER SOCKET DAEMON SYSTEMD SERVICE TEMPLATE
# Placeholders (${REPO_DIR}) are dynamically populated by daemon/install.sh
# ===================================================================
[Unit]
Description=LUKS Manager UNIX Domain Socket Daemon for WebApp Integration
After=network.target

[Service]
Type=simple
WorkingDirectory=${REPO_DIR}
ExecStart=/usr/bin/python3 ${REPO_DIR}/daemon/luks-managerd.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
